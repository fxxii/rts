{
  "name": "ironvale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools/*.ts *.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate:assets": "tsx tools/validate-assets.ts",
    "headless": "tsx tools/headless.ts",
    "sync:assets": "tsx tools/sync-assets.ts",
    "prebuild": "npm run sync:assets",
    "stress": "tsx tools/stress.ts",
    "predev": "npm run sync:assets"
  },
  "dependencies": {
    "three": "0.185.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "node": "24.13.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
